#!/system/bin/sh
# UniDroid Remote - key endpoint
# Sends an Android key event. Input is whitelisted to [A-Z0-9_] so no shell
# metacharacters can ever reach the command line.
echo "Content-Type: text/plain"
echo "Connection: close"
echo ""

k="${QUERY_STRING#k=}"
case "$k" in
  ""|*[!A-Z0-9_]*) printf 'bad'; exit 0 ;;
esac

input keyevent "$k" >/dev/null 2>&1 && printf 'ok' || printf 'err'
