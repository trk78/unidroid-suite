#!/system/bin/sh
# UniDroid Remote - text endpoint
# Types a string on the device. The decoded value is passed as a single quoted
# argument to `input text`, so it is never re-evaluated by the shell.
echo "Content-Type: text/plain"
echo "Connection: close"
echo ""

raw="${QUERY_STRING#t=}"
# URL-decode: '+' -> space, '%XX' -> byte.
dec=$(printf '%b' "$(printf '%s' "$raw" | sed 's/+/ /g; s/%/\\x/g')")
[ -z "$dec" ] && { printf 'empty'; exit 0; }

input text "$dec" >/dev/null 2>&1 && printf 'ok' || printf 'err'
